TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
# Railway inyecta DATABASE_URL; si existe, tiene prioridad sobre DB_*
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_DATABASE=scv
# Clave (>=16 caracteres) para cifrar api_key/api_secret SUNAT de cada empresa
ENCRYPTION_KEY=
# Base de la API de facturación (whuauyar/plataform-api-sunat), terminada en /api/v1
SUNAT_API_BASE_URL=https://api-sunat-production-6c5ea01b.up.railway.app/api/v1
SUNAT_API_TIMEOUT_MS=45000
# Orígenes permitidos para CORS (coma). Ej: https://web-production.up.railway.app
CORS_ORIGINS=http://localhost:5173

# SuperAdmin de la plataforma: el seeder lo crea si el correo no existe (clave >= 12 caracteres).
# Si el correo ya existe solo lo marca como SuperAdmin; nunca cambia su contraseña.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=SuperAdmin
# Límites anti abuso (tabla rate_limits en PostgreSQL)
LIMITER_STORE=database
LIMITE_ACCESO_POR_MINUTO=10
LIMITE_API_POR_MINUTO=300